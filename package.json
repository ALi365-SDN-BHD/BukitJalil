{
  "name": "bukitjalil",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @bukitjalil/web build",
    "start": "pnpm --filter @bukitjalil/server start",
    "check": "biome check . && pnpm -r typecheck && tsc -p tsconfig.json",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
