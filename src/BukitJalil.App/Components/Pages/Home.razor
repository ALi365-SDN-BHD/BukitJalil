@page "/"
@page "/projects"

<PageTitle>Projects</PageTitle>

<section class="workspace-page">
    <header class="workspace-page__header">
        <p class="workspace-page__eyebrow">Projects</p>
        <h1>Project control panel scaffold</h1>
        <p class="workspace-page__lede">
            This first milestone wires the BukitJalil shell so project management, workspace tooling,
            deployment targets, and settings can evolve independently.
        </p>
    </header>

    <div class="workspace-page__grid">
        <SectionCard
            Eyebrow="BJ-V1-013"
            Title="Project list"
            Description="List local website projects, recent activity, and the next task to open." />
        <SectionCard
            Eyebrow="BJ-V1-014"
            Title="Project creation"
            Description="Create a new BukitJalil project with local storage and future Bukit workspace metadata." />
    </div>
</section>
