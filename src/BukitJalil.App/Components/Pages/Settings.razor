@page "/settings"
@inject ISettingsStore SettingsStore

<PageTitle>Settings</PageTitle>

<section class="workspace-page">
    <header class="workspace-page__header">
        <p class="workspace-page__eyebrow">Settings</p>
        <h1>Environment and provider configuration</h1>
        <p class="workspace-page__lede">
            Settings will hold Bukit paths, document sources, default providers, and future model-specific options.
        </p>
    </header>

    <div class="workspace-page__grid">
        <section class="workspace-panel">
            <div class="workspace-panel__header">
                <div>
                    <p class="workspace-panel__eyebrow">BJ-V1-015</p>
                    <h2>Workspace dependencies</h2>
                </div>
            </div>

            <EditForm Model="_settings" OnSubmit="SaveSettings">
                <div class="form-stack">
                    <label class="field-label" for="bukit-path">Bukit path</label>
                    <InputText id="bukit-path" class="field-input" @bind-Value="_settings.BukitPath" />

                    <label class="field-label" for="documents-path">Documents path</label>
                    <InputText id="documents-path" class="field-input" @bind-Value="_settings.DocumentsPath" />

                    <label class="field-label" for="default-provider">Default provider</label>
                    <InputText id="default-provider" class="field-input" @bind-Value="_settings.DefaultProvider" />

                    <button class="btn btn-primary" type="submit">Save settings</button>
                </div>
            </EditForm>

            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <p class="save-status">@_statusMessage</p>
            }
        </section>

        <section class="workspace-panel">
            <SectionCard
                Eyebrow="Next"
                Title="Platform and provider expansion"
                Description="This page now persists Bukit path, docs path, and default provider. More advanced provider options can layer on top of the same store." />
        </section>
    </div>
</section>

@code {
    private AppSettings _settings = new();
    private string? _statusMessage;

    protected override void OnInitialized()
    {
        _settings = SettingsStore.Get();
    }

    private void SaveSettings()
    {
        SettingsStore.Save(_settings);
        _statusMessage = $"Saved at {DateTime.Now:HH:mm:ss}";
    }
}
